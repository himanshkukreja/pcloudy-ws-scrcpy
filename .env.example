# ws-scrcpy environment configuration
# Copy this file to dist/.env and fill in your values before starting the server.
# The server reads: node --env-file=.env ./index.js (run from inside dist/)

# Port for the HTTP + WebSocket server
PORT=8000

# Basic auth credentials for direct (non-token) admin access to the stream page
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Port of the rbox Node.js service running on this same machine.
# Used in the default stream token validation URL.
RBOX_SERVICE_PORT=4000

# Override the token validation endpoint when validation is handled by pBox.
STREAM_TOKEN_VALIDATE_URL=http://127.0.0.1:4000/api/v1/stream/validate

# Shared secret for internal ws-scrcpy validation calls.
# Sent as the Authorization header on every validate call.
INTERNAL_API_SECRET=change-me-to-a-random-secret

# Absolute adb binary path. Set this when the process PATH does not include adb.
ADB_BIN=/path/to/platform-tools/adb
